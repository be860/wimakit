{
  "expo": {
    "name": "WiMakit",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": [
      "wimakit",
      "wimakit.shop"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "bundleIdentifier": "wimakit.shop",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/app-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "wimakit.shop",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/wimakit-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "WiMakit uses your photo library so you can choose a profile picture.",
          "cameraPermission": "WiMakit uses your camera so you can take a new profile picture."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "WiMakit uses your microphone so you can send voice messages to farmers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ad52b86-87f4-43ce-ad81-2ab82ac394d7"
      }
    }
  }
}
